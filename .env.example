# Copy this file to .env and fill in real values before running docker-compose.
# Never commit the actual .env file.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=psych_screening

# Generate strong random values, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8080
# auto = AI dulu, otomatis pakai Tesseract bila AI gagal/belum dikonfigurasi | vlm = hanya AI | tesseract = hanya Tesseract (gratis)
OCR_PROVIDER=auto
OCR_API_KEY=
# --- Scan KTP dengan AI (VLM) ---
# Pilih provider: anthropic | openai | local   (kosong = otomatis dari variabel di bawah)
VLM_PROVIDER=anthropic
# Anthropic: kunci dari https://console.anthropic.com/ (Settings > API Keys). Jangan di-commit.
ANTHROPIC_API_KEY=
# Kosong = default provider (anthropic: claude-sonnet-5-5). Untuk openai/local isi nama model, mis. gpt-4o-mini / llava.
VLM_MODEL=
VLM_MAX_TOKENS=2048
# Field dengan confidence di bawah angka ini ditandai "Periksa kembali"
VLM_CONFIDENCE_THRESHOLD=0.80
VLM_TIMEOUT_S=30
MAX_KTP_FILE_SIZE_MB=5
# openai / local (OpenAI-compatible). Contoh lokal: VLM_BASE_URL=http://localhost:11434/v1 VLM_MODEL=llava
VLM_BASE_URL=
VLM_API_KEY=
# Alur lama /api/ocr/ktp: true = simpan hasil AI TANPA dicek user. Biarkan false.
VLM_AUTO_CONFIRM=false
VLM_AUTO_CONFIRM_MIN_CONFIDENCE=80
KTP_RETENTION_DELETE_AFTER_OCR=true
MAX_UPLOAD_SIZE_MB=5

VITE_API_URL=http://localhost:8000

# Used only by the one-off seed command (see README) to bootstrap the first admin.
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=
# Windows: path Tesseract bila tidak ada di PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
